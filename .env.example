# Copy to .env (never commit .env). See README.md for details.
PORT=4000
# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy/load balancer (Render, Railway, Nginx...)
TRUST_PROXY=0
# Long random string used by admin endpoints (x-admin-key header). Leave empty to disable admin endpoints.
ADMIN_API_KEY=

# ---- Binance deposit details -------------------------------------------
# Option A (simplest): paste your Binance USDT deposit addresses here.
# Binance app -> Wallet -> Deposit -> Crypto -> USDT -> choose network.
BINANCE_USDT_TRC20_ADDRESS=
BINANCE_USDT_BEP20_ADDRESS=
# Optional: Binance Pay ID, shown to donors as a zero-fee option for small gifts
BINANCE_PAY_ID=

# Option B (optional, enables automatic verification of donations):
# Create an API key with READ-ONLY permission. Do NOT enable trading or withdrawals.
# Restrict it to your server's IP address. Never share the secret or commit it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Donation limits in USDT
MIN_DONATION_USDT=0.3
MAX_DONATION_USDT=100000

# Where the JSON data file is stored (swap for a real database before heavy use)
DATA_FILE=./data/db.json
